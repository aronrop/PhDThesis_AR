@article{sunApplicationsMALDITOFMSStructural2023,
  title = {Applications of {{MALDI-TOF-MS}} in Structural Characterization of Synthetic Polymers},
  author = {Sun, A. 'Bin and Li, Siting and Kou, Xinhui},
  year = 2023,
