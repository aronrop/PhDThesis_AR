@article{golaInfluencePolyethyleneGlycol2022,
  title = {Influence of the {{Poly}}(Ethylene {{Glycol}}) {{Methyl Ether Methacrylates}} on the {{Selected Physicochemical Properties}} of {{Thermally Sensitive Polymeric Particles}} for {{Controlled Drug Delivery}}},
  author = {Gola, Agnieszka and Koz{\l}owska, Maria and Musia{\l}, Witold},
  year = 2022,
  journal = {Polymers},
  volume = {14},
  number = {21},
  pages = {4729},
  issn = {2073-4360},
  doi = {10.3390/polym14214729},
  abstract = {Thermosensitive copolymers P1--P5 of N-isopropylacrylamide (NIPA) and poly(ethylene glycol) methyl ether methacrylates (PEGMEMs) were synthesized via surfactant-free precipitation polymerization (SFPP) using ammonium persulfate (APS) at 70 {$^\circ$}C. The polymerization course was evaluated by the conductivity. The hydrodynamic diameters and the polydispersity indexes (PDI) of P1--P5 in the 18--45 {$^\circ$}C range, which were assessed via dynamic light scattering (DLS), were at 18{$^\circ$} (nm): 26.07 \textpm{} 0.54 (PDI 0.65 \textpm{} 0.03), 68.00 \textpm{} 1.10 (PDI 0.56 \textpm{} 0,02), 45.12 \textpm{} 0.57 (PDI 0.51 \textpm{} 0.03), 62.78 \textpm{} 0.40 (PDI 0.53 \textpm{} 0.003), and 92.95 \textpm{} 1.56 (PDI 0.60 \textpm{} 0.04), respectively. The lower critical solution temperatures ranged from 31 to 33 {$^\circ$}C. The electrophoretic mobilities estimated the zeta potential in the 18--45 {$^\circ$}C range, and at 18 {$^\circ$}C, they were (mV): -4.64 \textpm{} 1.30, -6.91 \textpm{} 2.67, -5.85 \textpm{} 3.17, -2.28 \textpm{} 0.30, and -3.60 \textpm{} 0.96 for P1--P5, respectively. The polymers were characterized by Attenuated Total Reflectance Fourier-Transform Infrared spectroscopy (ATR-FTIR), H nuclear magnetic resonance (1H NMR), thermogravimetric analysis (TGA/DTA), Differential Scanning Calorimetry (DSC), and powder X-ray diffraction analysis (PXRD). Stable amorphous polymers were obtained. We conclude that the length of the co-monomer chain nonlinearly influences the properties of the obtained thermosensitive polymer nanostructures.}
}

@article{golaInfluencePolyEthyleneGlycol2024,
  title = {Influence of {{Poly}}({{Ethylene Glycol}}) {{Dimethacrylates}}' {{Chain Length}} on {{Electrical Conductivity}} and {{Other Selected Physicochemical Properties}} of {{Thermally Sensitive N}}-Isopropylacrylamide {{Derivatives}}},
  author = {Gola, Agnieszka and Pod{\.z}us, Borys and Gruszka, Kinga and Musia{\l}, Witold},
  year = 2024,
  journal = {Polymers},
  volume = {16},
  number = {19},
  pages = {2786},
  issn = {2073-4360},
  doi = {10.3390/polym16192786},
  abstract = {Thermosensitive polymers P1--P6 of N-isopropylacrylamide (PNIPA) and poly(ethylene glycol) dimethacrylates (PEGDMAs), av. Mn 550--20,000, were synthesized via surfactant-free precipitation polymerization (SFPP) using ammonium persulfate (APS) at 70 {$^\circ$}C. The polymerization course was monitored by the conductivity. The hydrodynamic diameters (HDs) and the polydispersity indexes (PDIs) of the aqueous dispersion of P1--P6 in the 18--45 {$^\circ$}C range, assessed via dynamic light scattering (DLS), were at 18{$^\circ$} as follows (nm): 73.95 \textpm{} 19.51 (PDI 0.57 \textpm{} 0.08), 74.62 \textpm{} 0.76 (PDI 0.56 \textpm{} 0,01), 69.45 \textpm{} 1.47 (PDI 0.57 \textpm{} 0.03), 196.2 \textpm{} 2.50 (PDI 0.53 \textpm{} 0.04), 194.30 \textpm{} 3.36 (PDI 0.56 \textpm{} 0.04), 81.99 \textpm{} 0.53 (PDI 0.56 \textpm{} 0.01), 76.87 \textpm{} 0.30 (PDI 0.54 \textpm{} 0.01), respectively. The electrophoretic mobilities estimated the zeta potential (ZP) in the 18--45 {$^\circ$}C range, and at 18 {$^\circ$}C they were as follows (mV): -2.57 \textpm{} 0.10, -4.32 \textpm{} 0.67, -5.34 \textpm{} 0.95, --3.02 \textpm{} 0.76, -4.71 \textpm{} 2.69, -2.30 \textpm{} 0.36, -2.86 \textpm{} 0.42 for polymer dispersion P1--P6. The polymers were characterized by attenuated total reflectance--Fourier transform infrared spectroscopy (ATR-FTIR), H nuclear magnetic resonance (1H NMR), thermogravimetric analysis (TG/DTA), Differential Scanning Calorimetry (DSC), and powder X-ray diffraction analysis (PXRD). The length of the cross-linker chain influences the physicochemical properties of the obtained polymers.}
}

