  journal = {Macromolecules},
  volume = {50},
  number = {1},
  pages = {182--191},
  issn = {0024-9297, 1520-5835},
  doi = {10.1021/acs.macromol.6b01963},
  urldate = {2026-09-08},
  abstract = {Abstract             RAFT-synthesized polymers are typically colored and malodorous due to the presence of the sulfur-based RAFT end-group(s). In principle, RAFT end-groups can be removed by treating molecularly dissolved copolymer chains with excess free radical initiators, amines, or oxidants. Herein we report a convenient method for the removal of RAFT end-groups from aqueous dispersions of diblock copolymer nano-objects using H2O2. This oxidant is relatively cheap, has minimal impact on the copolymer morphology, and produces benign side products that can be readily removed via dialysis. We investigate the efficiency of end-group removal for various diblock copolymer nano-objects prepared with either dithiobenzoate- or trithiocarbonate-based RAFT chain transfer agents. The advantage of using UV GPC rather than UV spectroscopy is demonstrated for assessing both the kinetics and extent of end-group removal.},
