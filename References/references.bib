}

@article{jessonH2O2EnablesConvenient2017,
  title = {{{H2O2 Enables Convenient Removalof RAFT End-Groups}} from {{Block Copolymer Nano-Objects Prepared viaPolymerization-Induced Self-Assembly}} in {{Water}}},
  author = {Jesson, Craig P. and Pearce, Charles M. and Simon, Helene and Werner, Arthur and Cunningham, Victoria J. and Lovett, Joseph R. and Smallridge, Mark J. and Warren, Nicholas J. and Armes, Steven P.},
  year = 2017,
