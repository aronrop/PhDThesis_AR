@article{giliomeeSmartBlockCopolymers2016,
  title = {Smart Block Copolymers of {{PVP}} and an Alkylated {{PVP}} Derivative: Synthesis, Characterization, Thermoresponsive Behaviour and Self-Assembly},
  shorttitle = {Smart Block Copolymers of {{PVP}} and an Alkylated {{PVP}} Derivative},
  author = {Giliomee, Johnel and Pfukwa, Rueben and Gule, Nonjabulo P. and Klumperman, Bert},
  year = 2016,
  journal = {Polym. Chem.},
  volume = {7},
  number = {5},
  pages = {1138--1146},
  issn = {1759-9954, 1759-9962},
  doi = {10.1039/C5PY01609F},
  abstract = {Stimuli responsive block copolymers of biocompatible poly(3-ethyl-               N               -vinylpyrrolidone) and poly(               N               -vinylpyrrolidone),               i.e.               EPVP--PVP, were readily synthesized               via               RAFT-mediated polymerization.                        ,                             Stimuli responsive block copolymers of biocompatible poly(3-ethyl-               N               -vinylpyrrolidone) and poly(               N               -vinylpyrrolidone),               i.e.               EPVP--PVP, were readily synthesized               via               RAFT-mediated polymerization. The thermoresponsive behaviour and temperature induced self-assembly, in aqueous solutions, was studied using various spectroscopic and microscopy techniques. We obtained different morphologies,               i.e.               spherical and cylindrical micelles, and vesicles,               via               temperature induced self-assembly, of aqueous solutions of a single diblock copolymer by simply adjusting the solution concentration. This study establishes the biocompatible EPVP/PVP combination as a versatile stimuli responsive block copolymer system suitable for applications in drug delivery.}
}

@article{gilStimulireponsivePolymersTheir2004,
  title = {Stimuli-Reponsive Polymers and Their Bioconjugates},
  author = {Gil, E and Hudson, S},
  year = 2004,
  journal = {Progress in Polymer Science},
  volume = {29},
  number = {12},
  pages = {1173--1222},
