@article{iijimaSynthesisPolyIsopropylacrylamide2006,
  title = {Synthesis of Poly[ {{{\emph{N}}}} -isopropylacrylamide- {\emph{g}} -poly(Ethylene Glycol)] with a Reactive Group at the Poly(Ethylene Glycol) End and Its Thermosensitive Self-assembling Character},
  author = {Iijima, Michihiro and Nagasaki, Yukio},
