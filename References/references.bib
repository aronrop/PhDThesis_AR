@article{idziakThermosensitivityAqueousSolutions1999,
  title = {Thermosensitivity of {{Aqueous Solutions}} of {{Poly}}( {{{\emph{N}}}}{\emph{,}}{{{\emph{N}}}} -Diethylacrylamide)},
  author = {Idziak, I. and Avoce, D. and Lessard, D. and Gravel, D. and Zhu, X. X.},
