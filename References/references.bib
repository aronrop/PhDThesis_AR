@article{lessardEffectMolecularWeight2001,
  title = {Effect of the Molecular Weight on the Lower Critical Solution Temperature of Poly({{{\emph{N}}}} , {{{\emph{N}}}}-Diethylacrylamide) in Aqueous Solutions},
  author = {Lessard, D. G. and Ousalem, M. and Zhu, X. X.},
  year = 2001,
  journal = {Can. J. Chem.},
  volume = {79},
  number = {12},
  pages = {1870--1874},
  issn = {0008-4042, 1480-3291},
  doi = {10.1139/v01-180},
  abstract = {The molecular weight dependence of the lower critical solution temperature of poly(N,N-diethylacrylamide) was studied with 11 samples of the polymer with a number-average molecular weight (Mn) ranging from 9.6 \texttimes{} 103 to 1.3 \texttimes{} 106 g mol--1 and relatively narrow polydispersity indices from 1.19 and 2.60. These samples were obtained by fractional precipitation of the polymer. LCST values of polymers were measured by turbidimetry and microcalorimetry. An inverse dependence of LCST on the molar mass was found and the LCST of the samples remained more or less a constant above a critical molecular weight of ca. 2 \texttimes{} 105 g mol--1. The enthalpy and the entropy changes as well as the LCST of the polymer depend strongly on the molar mass of the polymer, especially in low molecular weight range.}
}

@article{lessardStudyPhaseTransition2003,
  title = {Study of the Phase Transition of Poly( {{{\emph{N}}}}{\emph{,}}{{{\emph{N}}}} -diethylacrylamide) in Water by Rheology and Dynamic Light Scattering},
  author = {Lessard, D. G. and Ousalem, M. and Zhu, X. X. and Eisenberg, A. and Carreau, P. J.},
  year = 2003,
  journal = {J Polym Sci B Polym Phys},
  volume = {41},
  number = {14},
  pages = {1627--1637},
  issn = {0887-6266, 1099-0488},
  doi = {10.1002/polb.10517},
  abstract = {Abstract                            Poly(               N,N               -diethylacrylamide) (PDEA) possesses a lower critical solution temperature (LCST) in aqueous media. The solution properties of PDEA at various temperatures have been characterized with techniques such as rheology and dynamic light scattering. There is a decrease in the coil size before the phase transition due to a coil-to-globule transition. At the LCST, rheological and dynamic light scattering studies have also confirmed an aggregation phenomenon. This aggregation modifies the rheological properties of the polymer solutions. High frequencies hinder the phase-transition process and reduce the LCST of the polymers. \copyright{} 2003 Wiley Periodicals, Inc. J Polym Sci Part B: Polym Phys 41: 1627--1637, 2003}
}

