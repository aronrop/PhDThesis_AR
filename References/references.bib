@article{kujawaVolumetricStudiesAqueous2001,
  title = {Volumetric {{Studies}} of {{Aqueous Polymer Solutions Using Pressure Perturbation Calorimetry}}: {{A New Look}} at the {{Temperature-Induced Phase Transition}} of {{Poly}}( {{{\emph{N}}}} -Isopropylacrylamide) in {{Water}} and {{D}}{\textsubscript{2}} {{O}}},
  shorttitle = {Volumetric {{Studies}} of {{Aqueous Polymer Solutions Using Pressure Perturbation Calorimetry}}},
  author = {Kujawa, Piotr and Winnik, Fran{\c c}oise M.},
  year = 2001,
  month = jun,
  journal = {Macromolecules},
  volume = {34},
